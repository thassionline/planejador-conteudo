# Supabase (Project Settings > API). Projeto separado do Financeiro e do Atendimento.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endereço público do sistema, usado nos links de aprovação
NEXT_PUBLIC_SITE_URL=https://planejador.descomplicadigital.com.br

# Chave de serviço (SÓ no servidor, nunca NEXT_PUBLIC_): o portal do cliente valida o token e assina as mídias com ela
